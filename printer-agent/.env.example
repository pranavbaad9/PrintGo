# ============================================================
# PrintGo Printer Agent — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# Backend URL — the deployed PrintGo API server
BACKEND_URL="http://localhost:5000"

# Machine Key — obtained from the admin panel when registering a machine
# Each kiosk gets a unique machine key
MACHINE_KEY="PASTE_MACHINE_KEY_FROM_ADMIN_PANEL"

# Printer Name — the exact Windows printer name (from Devices & Printers)
# Leave blank to use the system default printer
PRINTER_NAME=""
